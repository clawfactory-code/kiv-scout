# Copy this file to kiv-scout.toml and fill in local defaults as needed.
# Leave values commented out to use CLI defaults.

# default_repo = "/path/to/repo"
# default_capsule = "files"
# max_tokens = 6000
# max_files = 12
# include_tests = false
# auto_index = false

# MCP defaults are intentionally conservative. Raise these for larger context windows.
# mcp_max_tokens = 900
# mcp_max_files = 10

# Architecture policy is explicit and disabled unless enabled here.
# [architecture]
# enabled = true
#
# [[architecture.layers]]
# name = "domain"
# include = ["src/domain/**"]
#
# [[architecture.layers]]
# name = "infrastructure"
# include = ["src/infrastructure/**"]
#
# [[architecture.rules]]
# from = "domain"
# deny = ["infrastructure"]
