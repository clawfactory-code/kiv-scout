# Copy this file to kiv-scout.toml and fill in local defaults as needed.
# Leave values commented out to use CLI defaults.

# default_repo = "/path/to/repo"
# default_capsule = "files"
# max_tokens = 8000
# max_files = 24
# include_tests = false
# auto_index = false

# MCP ceilings default to 32,000 tokens and 40 files for current coding models.
# Lower these when the consuming client has a smaller context window.
# mcp_max_tokens = 32000
# mcp_max_files = 40

# Architecture policy is explicit and disabled unless enabled here.
# [architecture]
# enabled = true
#
# [[architecture.layers]]
# name = "domain"
# include = ["src/domain/**"]
#
# [[architecture.layers]]
# name = "infrastructure"
# include = ["src/infrastructure/**"]
#
# [[architecture.rules]]
# from = "domain"
# deny = ["infrastructure"]
